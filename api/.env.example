# LRACDIMENSION API — copy to .env and fill in. Never commit .env.
# Names only live here; values belong in .env locally and in the host's
# environment settings in production.

# PostgreSQL in production. SQLite is accepted for local development only.
DATABASE_URL=postgresql+psycopg://lracdim:password@localhost:5432/lracdim
# DATABASE_URL=sqlite:///./lracdim.db

# Optional. When set, audits and checks run on RQ workers via Redis.
# When unset, an in-process worker thread runs them (single instance only).
REDIS_URL=

# Origins allowed to call the API (comma-separated).
# Marketing site and dashboard origins.
CORS_ORIGINS=https://lracdimension.online,http://localhost:8099,http://localhost:5173

# Guards every admin route: Signal targets, contact submissions, the studio
# workflow, and the CMS. TODO: temporary; replace with signed sessions.
ADMIN_KEY=change-me

# Optional transactional email for contact notifications (SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=

# Optional webhook that receives a JSON copy of each contact submission and alert.
NOTIFY_WEBHOOK=

# Monitoring interval in seconds and thresholds.
SIGNAL_INTERVAL_SECONDS=300
SIGNAL_RESPONSE_WARN_MS=1500
SIGNAL_SSL_WARN_DAYS=14

# Crawler limits.
FETCH_TIMEOUT_SECONDS=12
FETCH_MAX_BYTES=3000000
AUDIT_MAX_LINKS_CHECKED=40
AUDIT_LINK_CONCURRENCY=6

# Rate limiting (requests per window per client IP).
RATE_LIMIT_AUDITS=6/hour
RATE_LIMIT_TOOLS=60/hour
RATE_LIMIT_CONTACT=5/hour
RATE_LIMIT_SIGNAL=10/hour

# Core Web Vitals in Vector reports (Google PageSpeed Insights API key). Empty = not measured.
PAGESPEED_API_KEY=

# --- Git-backed CMS ---------------------------------------------------------
# local  = write the working tree (development, default)
# github = commit on a branch through the GitHub API and open a pull request
CMS_ADAPTER=local
# Optional overrides; by default the API finds /content and /public/images
# relative to the repository root.
CMS_CONTENT_DIR=
CMS_IMAGES_DIR=
# Required when CMS_ADAPTER=github. The token needs contents and pull request
# write access on this repository only.
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
GITHUB_TOKEN=

# --- Zoho (off unless enabled) ----------------------------------------------
# See app/integrations/zoho/README.md. With ZOHO_ENABLED unset, no call is made.
ZOHO_ENABLED=false
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DATA_CENTER=com
ZOHO_WORKDRIVE_PARENT_ID=
