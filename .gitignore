# --- JavaScript apps (each app installs its own dependencies) ---------------
node_modules/
dist/
_site/
.cache/
*.log

# --- Python API --------------------------------------------------------------
api/.venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
api/*.db
api/alembic/__pycache__/

# --- Secrets: never commit a real value --------------------------------------
# .env.example files are tracked on purpose; everything else is ignored.
.env
.env.*
!.env.example
!**/.env.example
.dev.vars
*.local

# --- Hosting -----------------------------------------------------------------
.vercel
.wrangler/

# --- Generated mirrors of /content (the CMS is the source of truth) ----------
apps/marketing/src/research/*.md
apps/marketing/src/pages/*.md

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db
