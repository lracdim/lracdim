# The studio API in the Cloudflare Worker (worker/src/studio/), set at build time.
# Production (Vercel or Cloudflare Pages):
VITE_API_URL=https://lracdim-api.lracdim.workers.dev/api/studio
# Local development: leave VITE_API_URL unset (or delete it from .env.local).
# The dashboard then calls /api/studio on its own origin and Vite proxies it to
# the local Worker at http://127.0.0.1:8787 (override with WORKER_URL).
# The hosted dashboard's origin must also be listed in STUDIO_ORIGINS in
# worker/wrangler.jsonc, or the browser blocks its requests (CORS).
