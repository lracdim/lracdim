{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/admin{/}?",
      "destination": "/demos/clinic/portal/",
      "permanent": false
    },
    {
      "source": "/logs{/}?",
      "destination": "/research/",
      "permanent": true
    },
    {
      "source": "/logs.html{/}?",
      "destination": "/research/",
      "permanent": true
    },
    {
      "source": "/demos{/}?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/terminal{/}?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/builds{/}?",
      "destination": "/work/",
      "permanent": true
    },
    {
      "source": "/capabilities{/}?",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/operations{/}?",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/industries{/}?",
      "destination": "/services/#sectors",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/demos/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
