{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/contact{/}?",
      "destination": "/start/",
      "permanent": true
    },
    {
      "source": "/admin{/}?",
      "destination": "/demos/clinic/portal/",
      "permanent": false
    },
    {
      "source": "/logs{/}?",
      "destination": "/research/",
      "permanent": true
    },
    {
      "source": "/logs.html{/}?",
      "destination": "/research/",
      "permanent": true
    },
    {
      "source": "/demos{/}?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/terminal{/}?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/builds{/}?",
      "destination": "/work/",
      "permanent": true
    },
    {
      "source": "/capabilities{/}?",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/operations{/}?",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/industries{/}?",
      "destination": "/services/#sectors",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api-production-6e09c.up.railway.app; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(js|css)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=31536000, must-revalidate"
        }
      ]
    },
    {
      "source": "/demos/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/vector/audit/:id{/}?",
      "destination": "/vector/audit/"
    },
    {
      "source": "/signal/site/:id{/}?",
      "destination": "/signal/site/"
    }
  ]
}
