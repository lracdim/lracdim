<footer class="footer">
  <div class="shell">
    <div class="footer__mark">{% include "partials/logotype.njk" %}</div>

    <div class="footer__grid">
      <div>
        <p class="label label--faint">Pages</p>
        {% for item in site.nav %}
          <a class="footer__link" href="{{ item.href }}">{{ item.label }}</a>
        {% endfor %}
        <a class="footer__link" href="{{ site.cta.href }}">{{ site.cta.label }}</a>
      </div>

      <div>
        <p class="label label--faint">More</p>
        {% for item in site.footerLinks %}
          <a class="footer__link" href="{{ item.href }}">{{ item.label }}</a>
        {% endfor %}
        <button type="button" class="footer__link footer__link--btn" data-open-diagnostic>Website diagnostic</button>
      </div>

      <div>
        <p class="label label--faint">Contact</p>
        <a class="footer__link" href="mailto:{{ site.email }}">{{ site.email }}</a>
        <p class="footer__link">{{ site.location }}</p>
        {% for item in site.social %}{% if item.href and not (item.href.startsWith and item.href.startsWith('mailto:')) and item.label != 'Email' %}
          <a class="footer__link" href="{{ item.href }}" rel="noopener">{{ item.label }}</a>
        {% endif %}{% endfor %}
      </div>

      <div>
        <p class="label label--faint">Operator</p>
        <p class="footer__link" style="color:var(--paper)">{{ site.owner }}</p>
        <p class="footer__link">{{ site.role }}</p>
        <a class="btn btn--ghost" href="{{ site.cta.href }}" style="margin-top:.75rem">
          {{ site.cta.label }} <span class="btn__glyph" aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </div>

    <div class="footer__legal">
      <span class="label label--faint">&copy; {{ "" | year }} {{ site.owner }}</span>
      <span class="label label--faint">Built with Eleventy</span>
    </div>
  </div>
</footer>
