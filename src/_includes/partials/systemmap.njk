{#
  Hero background — a living operational system map.

  A request enters at the left, is captured by the intake form, routed by the
  workflow engine, then either booked into the schedule or written to the
  database and surfaced on the dashboard; a notification goes out and the
  job completes. systemmap.js runs "jobs" along these routes and each module
  reacts as a packet arrives. Labels are small and monospace so the diagram
  reads as a diagram.
#}
<div class="sysmap" data-sysmap aria-hidden="true">
  <svg class="sysmap__svg" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" focusable="false">
    <defs>
      <linearGradient id="sm-comet" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#4f8ff7" stop-opacity="0"/>
        <stop offset="1" stop-color="#4f8ff7" stop-opacity="0.9"/>
      </linearGradient>
    </defs>

    {# ---- routes ---------------------------------------------------- #}
    <g class="sysmap__routes" fill="none" stroke-linecap="round" stroke-linejoin="round">
      {# base lines #}
      <path class="sm-route" data-route="r1" data-from="m1" data-to="m2" style="--i:0" d="M240 660 H400 Q420 660 420 680 V705 H520"/>
      <path class="sm-route" data-route="r2" data-from="m2" data-to="m3" style="--i:1" d="M670 705 H780 Q800 705 800 685 V460 Q800 440 820 440 H900"/>
      <path class="sm-route" data-route="r3" data-from="m3" data-to="m4" style="--i:2" d="M1070 420 H1120 Q1140 420 1140 400 V250 H1180"/>
      <path class="sm-route" data-route="r4" data-from="m3" data-to="m5" style="--i:3" d="M1070 460 H1130 Q1150 460 1150 480 V570 H1200"/>
      <path class="sm-route" data-route="r5" data-from="m5" data-to="m6" style="--i:4" d="M1270 620 V660"/>
      <path class="sm-route" data-route="r6" data-from="m3" data-to="m7" style="--i:5" d="M985 380 V190"/>
      <path class="sm-route" data-route="r7" data-from="m7" data-to="m8" style="--i:6" d="M900 155 H830 Q810 155 810 175 V250 H790"/>
      <path class="sm-route" data-route="r8" data-from="m4" data-to="m8" style="--i:7" d="M1180 230 H1010 Q990 230 990 250 H790"/>
      {# flowing dashes on top of each base line #}
      <path class="sm-flow" d="M240 660 H400 Q420 660 420 680 V705 H520"/>
      <path class="sm-flow" d="M670 705 H780 Q800 705 800 685 V460 Q800 440 820 440 H900"/>
      <path class="sm-flow" d="M1070 420 H1120 Q1140 420 1140 400 V250 H1180"/>
      <path class="sm-flow" d="M1070 460 H1130 Q1150 460 1150 480 V570 H1200"/>
      <path class="sm-flow" d="M1270 620 V660"/>
      <path class="sm-flow" d="M985 380 V190"/>
      <path class="sm-flow" d="M900 155 H830 Q810 155 810 175 V250 H790"/>
      <path class="sm-flow" d="M1180 230 H1010 Q990 230 990 250 H790"/>
    </g>

    {# ---- modules ---------------------------------------------------- #}
    <g class="sysmap__modules">

      {# m1 request — a browser window with a cursor and a button being pressed #}
      <g class="sm-node sm-hide-sm" data-node="m1" transform="translate(120 620)">
        <rect class="sm-box" width="120" height="80" rx="8"/>
        <rect class="sm-bar" width="120" height="16" rx="8"/>
        <circle class="sm-dot" cx="12" cy="8" r="2"/><circle class="sm-dot" cx="20" cy="8" r="2"/><circle class="sm-dot" cx="28" cy="8" r="2"/>
        <rect class="sm-line" x="14" y="30" width="70" height="4" rx="2"/>
        <rect class="sm-line" x="14" y="41" width="48" height="4" rx="2"/>
        <rect class="sm-btn" x="14" y="56" width="34" height="12" rx="3"/>
        <path class="sm-cursor" d="M44 60 L52 68 L48 68 L50 73 L47 74 L45 69 L42 71 Z"/>
        <circle class="sm-status" cx="110" cy="-6" r="4"/>
        <text class="sm-label" x="0" y="96">request</text>
      </g>

      {# m2 intake — fields that fill as the request lands #}
      <g class="sm-node" data-node="m2" transform="translate(520 660)">
        <rect class="sm-box" width="150" height="90" rx="8"/>
        <rect class="sm-field" x="14" y="16" width="122" height="12" rx="3"/>
        <rect class="sm-field" x="14" y="36" width="122" height="12" rx="3"/>
        <rect class="sm-field" x="14" y="56" width="80" height="12" rx="3"/>
        <rect class="sm-fill-a" x="17" y="19" width="0" height="6" rx="2"/>
        <rect class="sm-fill-b" x="17" y="39" width="0" height="6" rx="2"/>
        <rect class="sm-fill-c" x="17" y="59" width="0" height="6" rx="2"/>
        <rect class="sm-btn" x="104" y="56" width="32" height="12" rx="3"/>
        <circle class="sm-status" cx="140" cy="-6" r="4"/>
        <text class="sm-label" x="0" y="106">intake form</text>
      </g>

      {# m3 workflow engine — a decision with two branches; the taken branch lights #}
      <g class="sm-node" data-node="m3" transform="translate(900 380)">
        <rect class="sm-box" width="170" height="110" rx="8"/>
        <circle class="sm-sym-dot" cx="22" cy="55" r="5"/>
        <path class="sm-sym" d="M27 55 H50"/>
        <path class="sm-sym sm-diamond" d="M50 55 L72 33 L94 55 L72 77 Z"/>
        <path class="sm-sym sm-branch" data-branch="up" d="M94 47 Q110 40 122 35"/>
        <path class="sm-sym sm-branch" data-branch="down" d="M94 63 Q110 70 122 75"/>
        <circle class="sm-sym-dot sm-branch-dot" data-branch="up" cx="128" cy="34" r="5"/>
        <circle class="sm-sym-dot sm-branch-dot" data-branch="down" cx="128" cy="76" r="5"/>
        <path class="sm-sym sm-sym--faint" d="M133 34 H148 M133 76 H148"/>
        <circle class="sm-status" cx="160" cy="-6" r="4"/>
        <text class="sm-label" x="0" y="126">workflow engine</text>
      </g>

      {# m4 schedule — a week grid; a packet books a cell #}
      <g class="sm-node" data-node="m4" transform="translate(1180 200)">
        <rect class="sm-box" width="180" height="100" rx="8"/>
        <rect class="sm-bar" width="180" height="18" rx="8"/>
        {% for c in [0,1,2,3,4,5,6] %}<rect class="sm-daylbl" x="{{ 14 + c*22 }}" y="7" width="10" height="3" rx="1"/>{% endfor %}
        {% for r in [0,1,2] %}{% for c in [0,1,2,3,4,5,6] %}
          <rect class="sm-cell{% if (r == 1 and c == 3) or (r == 2 and c == 1) %} sm-cell--on{% endif %}" data-cell x="{{ 14 + c*22 }}" y="{{ 30 + r*20 }}" width="16" height="12" rx="2"/>
        {% endfor %}{% endfor %}
        <circle class="sm-status" cx="170" cy="-6" r="4"/>
        <text class="sm-label" x="0" y="116">schedule</text>
      </g>

      {# m5 database — rows write in as packets arrive #}
      <g class="sm-node" data-node="m5" transform="translate(1200 520)">
        <rect class="sm-box" width="140" height="100" rx="8"/>
        <ellipse class="sm-sym" cx="70" cy="28" rx="34" ry="9"/>
        <path class="sm-sym" d="M36 28 V72 Q36 81 70 81 Q104 81 104 72 V28"/>
        <g data-rows>
          <rect class="sm-row" x="44" y="40" width="52" height="3" rx="1.5"/>
          <rect class="sm-row" x="44" y="48" width="52" height="3" rx="1.5"/>
          <rect class="sm-row" x="44" y="56" width="52" height="3" rx="1.5"/>
          <rect class="sm-row sm-row--new" x="44" y="64" width="0" height="3" rx="1.5"/>
        </g>
        <circle class="sm-status" cx="130" cy="-6" r="4"/>
        <text class="sm-label" x="0" y="116">database</text>
      </g>

      {# m6 dashboard — bars grow, the line ticks up #}
      <g class="sm-node" data-node="m6" transform="translate(1180 660)">
        <rect class="sm-box" width="200" height="110" rx="8"/>
        <rect class="sm-bar" width="200" height="16" rx="8"/>
        <g data-bars>
          <rect class="sm-col" x="20" y="70" width="14" height="24" rx="2"/>
          <rect class="sm-col" x="42" y="52" width="14" height="42" rx="2"/>
          <rect class="sm-col sm-col--on" x="64" y="40" width="14" height="54" rx="2"/>
          <rect class="sm-col" x="86" y="60" width="14" height="34" rx="2"/>
        </g>
        <path class="sm-sym sm-sym--faint" data-line d="M118 84 L136 66 L152 74 L176 46"/>
        <circle class="sm-sym-dot sm-sym-dot--on" data-linedot cx="176" cy="46" r="3"/>
        <text class="sm-kpi" x="118" y="40">+1</text>
        <circle class="sm-status" cx="190" cy="-6" r="4"/>
        <text class="sm-label" x="0" y="126">dashboard</text>
      </g>

      {# m7 notification — badge count bumps #}
      <g class="sm-node sm-hide-sm" data-node="m7" transform="translate(900 120)">
        <rect class="sm-box" width="110" height="70" rx="8"/>
        <path class="sm-sym" d="M43 44 V34 a12 12 0 0 1 24 0 v10 l5 5 H38 Z M50 52 a5 5 0 0 0 10 0"/>
        <circle class="sm-badge" cx="70" cy="26" r="7"/>
        <text class="sm-badge-n" x="70" y="29.5" data-badge>3</text>
        <circle class="sm-status" cx="100" cy="-6" r="4"/>
        <text class="sm-label" x="0" y="86">notify</text>
      </g>

      {# m8 completed — the check draws when a job finishes #}
      <g class="sm-node" data-node="m8" transform="translate(700 220)">
        <rect class="sm-box" width="90" height="60" rx="8"/>
        <circle class="sm-sym" cx="45" cy="30" r="14"/>
        <path class="sm-sym sm-check" d="M37 30 L43 36 L54 24"/>
        <circle class="sm-status" cx="80" cy="-6" r="4"/>
        <text class="sm-label" x="0" y="76">completed</text>
      </g>
    </g>

    {# ---- readout ---------------------------------------------------- #}
    <g class="sm-readout" transform="translate(1180 130)">
      <text class="sm-readout__k" x="0" y="0">processed</text>
      <text class="sm-readout__v" x="0" y="26" data-counter>000</text>
      <text class="sm-readout__k" x="96" y="0">in flight</text>
      <text class="sm-readout__v" x="96" y="26" data-inflight>0</text>
    </g>

    <g class="sysmap__packets" data-packets></g>
  </svg>
</div>
