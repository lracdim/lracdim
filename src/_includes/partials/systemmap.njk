{#
  Hero background — a living operational system map.
  Eight abstract modules (client request, intake, workflow engine, scheduling,
  database, dashboard, notification, completed) joined by routes. Denser on
  the right and edges; the centre-left stays calm for the headline.
  Routes draw in on load; systemmap.js sends packets and flips node states.
  No labels are rendered — shapes only.
#}
<div class="sysmap" data-sysmap aria-hidden="true">
  <svg class="sysmap__svg" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" focusable="false">
    <defs>
      <clipPath id="sm-win"><rect x="0" y="0" width="120" height="80" rx="8"/></clipPath>
    </defs>

    {# ---- routes (drawn in order) ---------------------------------- #}
    <g class="sysmap__routes" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path class="sm-route" data-route="r1" data-to="m2" style="--i:0" d="M240 660 H400 Q420 660 420 680 V705 H520"/>
      <path class="sm-route" data-route="r2" data-to="m3" style="--i:1" d="M670 705 H780 Q800 705 800 685 V460 Q800 440 820 440 H900"/>
      <path class="sm-route" data-route="r3" data-to="m4" style="--i:2" d="M1070 420 H1120 Q1140 420 1140 400 V250 H1180"/>
      <path class="sm-route" data-route="r4" data-to="m5" style="--i:3" d="M1070 460 H1130 Q1150 460 1150 480 V570 H1200"/>
      <path class="sm-route" data-route="r5" data-to="m6" style="--i:4" d="M1270 620 V660"/>
      <path class="sm-route" data-route="r6" data-to="m7" style="--i:5" d="M985 380 V190"/>
      <path class="sm-route" data-route="r7" data-to="m8" style="--i:6" d="M900 155 H830 Q810 155 810 175 V250 H790"/>
      <path class="sm-route sm-route--faint" data-route="r8" data-to="m8" style="--i:7" d="M1180 230 H1010 Q990 230 990 250 H790"/>
    </g>

    {# ---- modules ---------------------------------------------------- #}
    <g class="sysmap__modules">

      {# m1 client request — a browser window (bottom-left edge) #}
      <g class="sm-node sm-hide-sm" data-node="m1" transform="translate(120 620)">
        <rect class="sm-box" width="120" height="80" rx="8"/>
        <rect class="sm-bar" x="0" y="0" width="120" height="16" rx="8"/>
        <circle class="sm-dot" cx="12" cy="8" r="2"/><circle class="sm-dot" cx="20" cy="8" r="2"/><circle class="sm-dot" cx="28" cy="8" r="2"/>
        <rect class="sm-line" x="14" y="32" width="70" height="4" rx="2"/>
        <rect class="sm-line" x="14" y="44" width="48" height="4" rx="2"/>
        <rect class="sm-line sm-line--cta" x="14" y="58" width="30" height="8" rx="3"/>
        <circle class="sm-status" cx="110" cy="-6" r="4"/>
      </g>

      {# m2 intake form (bottom centre) #}
      <g class="sm-node" data-node="m2" transform="translate(520 660)">
        <rect class="sm-box" width="150" height="90" rx="8"/>
        <rect class="sm-field" x="14" y="16" width="122" height="12" rx="3"/>
        <rect class="sm-field" x="14" y="36" width="122" height="12" rx="3"/>
        <rect class="sm-field" x="14" y="56" width="80" height="12" rx="3"/>
        <rect class="sm-line sm-line--cta" x="104" y="56" width="32" height="12" rx="3"/>
        <circle class="sm-status" cx="140" cy="-6" r="4"/>
      </g>

      {# m3 workflow engine (right-centre) — decision diamond and steps #}
      <g class="sm-node" data-node="m3" transform="translate(900 380)">
        <rect class="sm-box" width="170" height="110" rx="8"/>
        <path class="sm-sym" d="M52 55 L72 35 L92 55 L72 75 Z"/>
        <circle class="sm-sym-dot" cx="22" cy="55" r="5"/>
        <circle class="sm-sym-dot" cx="122" cy="35" r="5"/>
        <circle class="sm-sym-dot" cx="122" cy="75" r="5"/>
        <path class="sm-sym" d="M27 55 H52 M92 45 L117 37 M92 65 L117 73"/>
        <circle class="sm-sym-dot" cx="148" cy="55" r="5"/>
        <path class="sm-sym" d="M127 37 Q140 45 143 53 M127 73 Q140 65 143 57"/>
        <circle class="sm-status" cx="160" cy="-6" r="4"/>
      </g>

      {# m4 scheduling (top right) — calendar grid #}
      <g class="sm-node" data-node="m4" transform="translate(1180 200)">
        <rect class="sm-box" width="180" height="100" rx="8"/>
        <rect class="sm-bar" x="0" y="0" width="180" height="18" rx="8"/>
        {% for r in [0,1,2] %}{% for c in [0,1,2,3,4,5,6] %}
          <rect class="sm-cell{% if (r == 1 and c == 3) or (r == 2 and c == 1) %} sm-cell--on{% endif %}" x="{{ 14 + c*22 }}" y="{{ 30 + r*20 }}" width="16" height="12" rx="2"/>
        {% endfor %}{% endfor %}
        <circle class="sm-status" cx="170" cy="-6" r="4"/>
      </g>

      {# m5 database (right) — cylinder #}
      <g class="sm-node" data-node="m5" transform="translate(1200 520)">
        <rect class="sm-box" width="140" height="100" rx="8"/>
        <ellipse class="sm-sym" cx="70" cy="30" rx="34" ry="10"/>
        <path class="sm-sym" d="M36 30 V70 Q36 80 70 80 Q104 80 104 70 V30"/>
        <path class="sm-sym sm-sym--faint" d="M36 50 Q36 60 70 60 Q104 60 104 50"/>
        <circle class="sm-status" cx="130" cy="-6" r="4"/>
      </g>

      {# m6 dashboard (bottom right) — bars and a line #}
      <g class="sm-node" data-node="m6" transform="translate(1180 660)">
        <rect class="sm-box" width="200" height="110" rx="8"/>
        <rect class="sm-bar" x="0" y="0" width="200" height="16" rx="8"/>
        <rect class="sm-col" x="20" y="70" width="14" height="24" rx="2"/>
        <rect class="sm-col" x="42" y="52" width="14" height="42" rx="2"/>
        <rect class="sm-col sm-col--on" x="64" y="40" width="14" height="54" rx="2"/>
        <rect class="sm-col" x="86" y="60" width="14" height="34" rx="2"/>
        <path class="sm-sym sm-sym--faint" d="M118 84 L136 66 L152 74 L176 46"/>
        <circle class="sm-sym-dot sm-sym-dot--on" cx="176" cy="46" r="3"/>
        <circle class="sm-status" cx="190" cy="-6" r="4"/>
      </g>

      {# m7 notification (top centre-right) — bell as circle + dot #}
      <g class="sm-node sm-hide-sm" data-node="m7" transform="translate(900 120)">
        <rect class="sm-box" width="110" height="70" rx="8"/>
        <circle class="sm-sym" cx="55" cy="35" r="14"/>
        <circle class="sm-sym-dot sm-sym-dot--on" cx="66" cy="24" r="4"/>
        <circle class="sm-status" cx="100" cy="-6" r="4"/>
      </g>

      {# m8 completed (centre-right, small) — check #}
      <g class="sm-node" data-node="m8" transform="translate(700 220)">
        <rect class="sm-box" width="90" height="60" rx="8"/>
        <circle class="sm-sym" cx="45" cy="30" r="14"/>
        <path class="sm-sym sm-check" d="M37 30 L43 36 L54 24"/>
        <circle class="sm-status" cx="80" cy="-6" r="4"/>
      </g>

    </g>

    {# packets are appended here by systemmap.js #}
    <g class="sysmap__packets" data-packets></g>
  </svg>
</div>
