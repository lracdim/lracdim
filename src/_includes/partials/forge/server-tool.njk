<form class="forge-server" data-server-form novalidate>
  <div class="forge-field"><label for="tool-url">Website or page URL</label><input id="tool-url" name="url" type="text" inputmode="url" autocomplete="url" spellcheck="false" placeholder="https://example.com/" required></div>
  <div class="forge-actions"><button type="submit" class="btn" data-action="run">Run ↗</button></div>
  <p class="forge-status" data-status role="status"></p>
</form>
<div class="forge-output" data-output aria-live="polite"></div>
