<div class="forge-grid">
  <div class="forge-field"><label for="re-pattern">Pattern</label><input id="re-pattern" type="text" spellcheck="false" placeholder="(\w+)@(\w+)\.com"></div>
  <div class="forge-field"><label for="re-flags">Flags</label><input id="re-flags" type="text" spellcheck="false" value="g" placeholder="gimsuy" maxlength="6"></div>
</div>
<div class="forge-field"><label for="re-text">Test text</label><textarea id="re-text" rows="8" spellcheck="false" placeholder="jane@example.com, bob@test.com"></textarea></div>
<div class="forge-output" data-output aria-live="polite"></div>
<p class="forge-status" data-status role="status"></p>
