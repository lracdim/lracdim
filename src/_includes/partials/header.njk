<header class="header" data-header>
  <div class="shell header__inner">
    <a class="brand" href="/">
      <img class="brand__logo" src="/assets/img/brand/mark.png" width="72" height="72" alt="{{ site.name }}">
    </a>

    <nav class="nav header__nav" aria-label="Primary">
      {% for item in site.nav %}
        <a class="nav__link" href="{{ item.href }}"
           {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>

    <a class="btn header__cta" href="{{ site.cta.href }}">
      {{ site.cta.label }} <span class="btn__glyph" aria-hidden="true">&#8599;</span>
    </a>

    <button type="button" class="nav-toggle" data-nav-toggle aria-expanded="false" aria-controls="drawer">
      <span data-nav-toggle-label>Menu</span>
      <span class="nav-toggle__bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<div class="drawer" id="drawer" data-drawer>
  <div>
    <a class="btn btn--block drawer__cta" href="{{ site.cta.href }}">
      {{ site.cta.label }} <span class="btn__glyph" aria-hidden="true">&#8599;</span>
    </a>
    <nav aria-label="Mobile">
      {% for item in site.nav %}
        <a class="drawer__link" href="{{ item.href }}">
          <span class="drawer__index">{{ loop.index0 | pad }}</span>{{ item.label }}
        </a>
      {% endfor %}
    </nav>
  </div>
  <div>
    <button type="button" class="link" data-open-diagnostic>
      Run a website diagnostic <span class="btn__glyph" aria-hidden="true">&#8599;</span>
    </button>
    <p class="label label--faint" style="margin-top:1.25rem">{{ site.location }}</p>
  </div>
</div>
