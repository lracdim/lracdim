<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {%- set pageTitle = (title ~ " — " ~ site.name) if title else (site.name ~ " — " ~ site.role) -%}
  {%- set pageDesc = description or site.description -%}
  {%- set pageUrl = site.url ~ page.url -%}
  {%- set ogImage = site.url ~ (image or '/assets/img/og.png') -%}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <meta name="author" content="{{ site.owner }}">
  <meta name="google-site-verification" content="hYGfFWE0e-88-pv-W5oOE2OzDJCw0pph4NlNRts_hm4">
  <meta name="robots" content="{% if noindex %}noindex, nofollow{% else %}index, follow, max-image-preview:large{% endif %}">
  <link rel="canonical" href="{{ pageUrl }}">

  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="en_US">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ pageTitle }}">
  {%- if ogType == 'article' %}
  <meta property="article:published_time" content="{{ page.date | date_iso }}">
  <meta property="article:author" content="{{ site.owner }}">
  {%- if topic %}<meta property="article:section" content="{{ topic }}">{% endif %}
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDesc }}">
  <meta name="twitter:image" content="{{ ogImage }}">
  <meta name="theme-color" content="#18191b">

  <link rel="icon" href="/assets/img/brand/favicon-64.png" type="image/png" sizes="64x64">
  <link rel="apple-touch-icon" href="/assets/img/brand/apple-touch-icon.png">

  <link rel="stylesheet" href="/assets/css/main.css">
  <link rel="stylesheet" href="/assets/css/studio.css">
  <noscript><style>.header__nav{display:flex!important;flex-wrap:wrap}.header__cta,.nav-toggle,.layer-controls,.pipeline-detail button,[data-open-diagnostic]{display:none!important}.header,.header__inner{height:auto!important;min-height:80px}.header__inner{flex-wrap:wrap;padding-block:14px;gap:20px}[data-reveal]{opacity:1!important;transform:none!important}</style></noscript>
  <script type="application/ld+json">
  {{ {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": site.url ~ "/#person",
        "name": site.owner,
        "jobTitle": site.role,
        "url": site.url,
        "email": "mailto:" ~ site.email,
        "image": site.url ~ site.portrait,
        "address": { "@type": "PostalAddress", "addressLocality": site.location },
        "sameAs": [site.social[1].href],
        "knowsAbout": ["WordPress", "React", "TypeScript", "Node.js", "PHP", "PostgreSQL", "n8n", "Web automation", "AI integration"]
      },
      {
        "@type": "WebSite",
        "@id": site.url ~ "/#website",
        "url": site.url,
        "name": site.name,
        "description": site.description,
        "publisher": { "@id": site.url ~ "/#person" },
        "inLanguage": "en"
      }
    ] | list
  } | json | safe }}
  </script>
  {%- if ogType == 'article' %}
  <script type="application/ld+json">
  {{ {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "datePublished": page.date | date_iso,
    "dateModified": page.date | date_iso,
    "articleSection": topic,
    "wordCount": content | word_count,
    "author": { "@type": "Person", "@id": site.url ~ "/#person", "name": site.owner },
    "publisher": { "@type": "Person", "@id": site.url ~ "/#person", "name": site.owner },
    "image": site.url ~ (image or "/assets/img/og.png"),
    "mainEntityOfPage": site.url ~ page.url,
    "inLanguage": "en"
  } | json | safe }}
  </script>
  {%- endif %}
  {%- set crumbSection = false %}
  {%- if ogType == 'article' %}{% set crumbSection = { name: 'Research', href: '/research/' } %}
  {%- elif project and project.slug %}{% set crumbSection = { name: 'Work', href: '/work/' } %}{% endif %}
  {%- if crumbSection %}
  <script type="application/ld+json">
  {{ {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": site.url ~ "/" },
      { "@type": "ListItem", "position": 2, "name": crumbSection.name, "item": site.url ~ crumbSection.href },
      { "@type": "ListItem", "position": 3, "name": title, "item": site.url ~ page.url }
    ]
  } | json | safe }}
  </script>
  {%- endif %}
</head>

<body data-contact-email="{{ site.email }}">
  <script>
    /* Runtime integrations, from _data/site.js. Empty strings degrade honestly. */
    window.LRACDIM = {
      scanEndpoint: {{ site.scanEndpoint | json | safe }},
      leadWebhook: {{ site.leadWebhook | json | safe }},
      email: {{ site.email | json | safe }}
    };
  </script>

  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
  {% include "partials/diagnostic.njk" %}

  <script type="module" src="/assets/js/studio.js"></script>
  {% if scene %}<script type="module" src="/assets/js/system-scene.js"></script>{% endif %}
</body>
</html>
