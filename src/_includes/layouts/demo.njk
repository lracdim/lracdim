<!doctype html>
<html lang="en" class="demo-root">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{% if demoTitle %}{{ demoTitle }} — {{ demo.brand.name }}{% else %}{{ demo.brand.name }}{% endif %}</title>
  <meta name="description" content="{{ demoDescription or demo.brand.description }}">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#12302a">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="{{ demo.fonts }}">

  {#
    Only this demo's stylesheet is loaded. The portfolio's main.css is never
    included here, and every rule in theme.css is scoped under .demo-clinic,
    so nothing can travel in either direction.
  #}
  <link rel="stylesheet" href="{{ demo.cssPath }}">

  <link rel="icon" href="/assets/demos/{{ demoMeta.slug }}/favicon.svg" type="image/svg+xml">
</head>

<body class="{{ demo.themeClass }}{% if portal %} is-portal{% endif %}">

  {# Hands the whole demo dataset to app.js without a network request. #}
  <script type="application/json" id="demo-data">{{ demo | json | safe }}</script>

  {{ content | safe }}

  {% if demo.demoMode %}
    <aside class="demo-badge" aria-label="Demonstration notice">
      <span class="demo-badge__dot" aria-hidden="true"></span>
      <span class="demo-badge__text">
        Demo — sample data.
        <a href="/">Back to LRACDIMENSION</a>
      </span>
    </aside>
  {% endif %}

  {# Motion libraries load only inside demos, never on portfolio pages. #}
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js" defer></script>
  <script src="{{ demo.jsPath }}" type="module"></script>

  <script src="/assets/demos/prospect.js" defer></script>
</body>
</html>
