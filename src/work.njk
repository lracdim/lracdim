---
layout: layouts/base.njk
title: Work
permalink: /work/
description: Named projects with their real status — live, internal, demo, concept — the stack behind each, and case notes on the ones with the most to say.
---

{% set featured = [] %}{% set rest = [] %}
{% for p in projects %}{% if p.featured %}{% set featured = (featured.push(p), featured) %}{% else %}{% set rest = (rest.push(p), rest) %}{% endif %}{% endfor %}

<section class="pagehead">
  <div class="hero__grid-bg" aria-hidden="true"></div>
  <div class="shell" style="position:relative;z-index:1">
    <span class="label label--signal">Work</span>
    <h1 class="h1" style="margin-top:1rem">Named projects, labelled honestly</h1>
    <p class="lede" style="margin-top:1.5rem">
      What was built, on what stack, and what state it is in. A demo is
      marked as a demo and a concept as a concept. Nothing here claims a
      number the work did not produce.
    </p>
    <div class="pagehead__meta">
      <span class="label label--faint">{{ projects.length }} projects</span>
      <span class="label label--faint">{{ logs.length }} case notes</span>
      <span class="label label--faint">Security · logistics · education · government</span>
    </div>
  </div>
</section>

{# ================================================= FEATURED ============ #}
<section class="band section">
  <div class="shell">
    <div class="eyebrow">
      <span class="label">Selected</span>
      <span class="eyebrow__rule"></span>
      <span class="label label--plain label--faint">{{ featured.length }} systems in use</span>
    </div>

    <div class="cards">
      {% for p in featured %}
        <article class="card project" id="{{ p.slug }}" data-reveal data-reveal-delay="{{ loop.index0 * 60 }}">
          <div class="card__media">
            <span class="card__badge">{{ p.category }}</span>
            <img src="{{ p.img }}" alt="{{ p.name }}" loading="lazy" decoding="async">
          </div>
          <div class="card__body">
            <div class="tpl__row">
              <span class="label label--signal">{{ p.org }}</span>
              <span class="status status--{{ p.status }}">{{ p.status }}</span>
            </div>
            <h2 class="h3" style="margin-top:.9rem">{{ p.name }}</h2>
            <p class="body body--sm" style="margin-top:.75rem">{{ p.summary }}</p>
            <ul class="project__facts">
              {% for f in p.facts %}<li>{{ f }}</li>{% endfor %}
            </ul>
            <div class="work__tech">
              {% for t in p.stack %}<span class="tag">{{ t }}</span>{% endfor %}
            </div>
            {% if p.url %}
              <div class="project__links">
                <a class="link" href="{{ p.url }}" rel="noopener" target="_blank">Open {{ p.url | replace('https://', '') }} <span class="btn__glyph" aria-hidden="true">&#8599;</span></a>
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{# ================================================= CASE NOTES ========== #}
<section class="band band--dark section">
  <div class="shell">
    <div class="eyebrow">
      <span class="label">Case notes</span>
      <span class="eyebrow__rule"></span>
      <span class="label label--plain label--faint">Problem · approach · what was delivered</span>
    </div>

    <div class="work">
      {% for log in logs %}
        <a class="work__item" href="/logs/#log-{{ loop.index0 | pad }}" data-reveal data-reveal-delay="{{ loop.index0 * 60 }}">
          <span class="work__index">{{ loop.index0 | pad }}</span>
          <span>
            <span class="work__title">{{ log.title | replace('_', ' ') }}</span>
            <span class="work__tech work__meta">
              {% for t in log.tags | slice_first(3) %}<span class="tag">{{ t | replace('_', ' ') }}</span>{% endfor %}
            </span>
          </span>
          <span class="work__meta"><span class="work__desc">{{ log.perf }} — {{ log.arch }}</span></span>
          <span class="work__glyph" aria-hidden="true">&#8599;</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{# ================================================= THE REST ============ #}
<section class="band section">
  <div class="shell">
    <div class="eyebrow">
      <span class="label">Demos, concepts and client builds</span>
      <span class="eyebrow__rule"></span>
      <span class="label label--plain label--faint">{{ rest.length }} more</span>
    </div>

    <div class="work">
      {% for p in rest %}
        <div class="work__item project" id="{{ p.slug }}" data-reveal data-reveal-delay="{{ loop.index0 * 50 }}">
          <span class="work__index">{{ loop.index0 | pad }}</span>
          <span>
            <span class="work__title">{{ p.name }}</span>
            <span class="work__tech work__meta">
              <span class="status status--{{ p.status }}">{{ p.status }}</span>
              {% for t in p.stack %}<span class="tag">{{ t }}</span>{% endfor %}
            </span>
          </span>
          <span class="work__meta">
            <span class="work__desc">{{ p.summary }}</span>
            {% if p.url %}<a class="link" style="margin-top:.6rem" href="{{ p.url }}" rel="noopener" target="_blank">{{ p.url | replace('https://', '') }} <span class="btn__glyph" aria-hidden="true">&#8599;</span></a>{% endif %}
          </span>
          <span class="work__glyph" aria-hidden="true"></span>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="band section section--tight">
  <div class="shell">
    <div class="stats">
      {% for stat in stats %}
        <div class="stat" data-reveal data-reveal-delay="{{ loop.index0 * 80 }}">
          <div class="stat__count">{{ stat.count }}</div>
          <div class="stat__title">{{ stat.title }}</div>
          <div class="stat__desc">{{ stat.desc }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="band band--dark section">
  <div class="shell">
    <div class="split">
      <div class="split__lead"><h2 class="h2">Have something like this that needs building?</h2></div>
      <div class="split__body">
        <p class="lede" style="margin-bottom:2rem">
          Describe the operation and where it leaks. You get a written reply
          within one business day with a straight answer on fit.
        </p>
        <a class="btn" href="/start/">Start a project <span class="btn__glyph" aria-hidden="true">&#8599;</span></a>
      </div>
    </div>
  </div>
</section>
