---
layout: layouts/base.njk
title: Capabilities
permalink: /capabilities/
description: Not a tech list. What I can actually do for you, translated into operational outcomes rather than raw technology names.
---

<section class="pagehead">
  <div class="hero__grid-bg" aria-hidden="true"></div>
  <div class="shell" style="position:relative;z-index:1">
    <span class="label label--signal">Translation layer</span>
    <h1 class="h1" style="margin-top:1rem">Capabilities</h1>
    <p class="lede" style="margin-top:1.5rem">
      Not just tech lists. Here&rsquo;s what I can actually do for you &mdash;
      translated into real business value, not raw technology names.
    </p>
  </div>
</section>

<section class="band section">
  <div class="shell">
    <div class="eyebrow">
      <span class="label">Core disciplines</span>
      <span class="eyebrow__rule"></span>
    </div>

    <div class="cards">
      {% for cap in capabilities.primary %}
        <article class="card" data-reveal data-reveal-delay="{{ loop.index0 * 70 }}">
          <div class="card__body">
            <span class="label label--signal">{{ cap.tag }}</span>
            <h2 class="h3" style="margin-top:1rem">{{ cap.title }}</h2>
            <p class="body body--sm" style="margin-top:.75rem">{{ cap.desc }}</p>
            <div class="work__tech">
              {% for t in cap.tags %}<span class="tag">{{ t }}</span>{% endfor %}
            </div>
          </div>
          <div class="card__foot">
            <span class="label label--faint">{{ loop.index0 | pad }}</span>
            <span class="label label--faint">Enterprise grade</span>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="band section" style="border-top:1px solid var(--ink-14)">
  <div class="shell">
    <div class="eyebrow">
      <span class="label">System patterns</span>
      <span class="eyebrow__rule"></span>
    </div>

    <div class="cells">
      {% for cap in capabilities.secondary %}
        <div class="cell" data-reveal data-reveal-delay="{{ loop.index0 * 70 }}">
          <span class="cell__num">{{ loop.index0 | pad }}</span>
          <div class="cell__title">{{ cap.title }}</div>
          <p class="cell__desc">{{ cap.desc }}</p>
          <div class="work__tech">
            {% for t in cap.tags %}<span class="tag">{{ t }}</span>{% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="band band--dark section">
  <div class="shell">
    <div class="split">
      <div class="split__lead">
        <h2 class="h2">Start with a diagnosis, not a proposal.</h2>
      </div>
      <div class="split__body">
        <p class="lede" style="margin-bottom:2rem">
          The diagnostic reads your public footprint and reports where the
          friction actually sits &mdash; before anyone talks scope or price.
        </p>
        <button type="button" class="btn btn--ghost" data-open-diagnostic>
          Run diagnostic <span class="btn__glyph" aria-hidden="true">&#8599;</span>
        </button>
      </div>
    </div>
  </div>
</section>
