---
layout: layouts/base.njk
pagination:
  data: portfolio
  size: 1
  alias: project
permalink: /work/{{ project.slug }}/
eleventyComputed:
  title: "{{ project.title }}"
  description: "{{ project.summary }}"
---
<article class="case-study shell"><a class="text-link" href="/work/">← All projects</a><header class="page-intro"><p class="overline">{{ project.kind }} / {{ project.field }}</p><h1>{{ project.title }}</h1><p>{{ project.summary }}</p><div class="tech-list">{% for tech in project.tech %}<span>{{ tech }}</span>{% endfor %}</div></header>{% if project.image %}<figure class="case-image"><img src="/assets/img/projects/{{ project.image }}.webp" width="{{ project.imageWidth }}" height="{{ project.imageHeight }}" alt="{{ project.title }} website screenshot"></figure>{% endif %}<div class="case-body"><aside><p class="project-type">My role</p><h2>{{ project.role }}</h2>{% if project.url %}<a class="btn" href="{{ project.url }}" target="_blank" rel="noopener noreferrer">{{ project.linkLabel }} ↗</a>{% endif %}</aside><div><section><h2>The project</h2><p>{{ project.context }}</p></section><section><h2>What I built</h2><p>{{ project.approach }}</p><ul>{% for feature in project.features %}<li>{{ feature }}</li>{% endfor %}</ul></section><section><h2>The outcome</h2><p>{{ project.result }}</p></section>{% if project.note %}<p class="case-note">{{ project.note }}</p>{% endif %}</div></div></article>{% include "partials/studio-contact.njk" %}
