---
layout: layouts/base.njk
pagination:
  data: portfolio
  size: 1
  alias: project
  addAllPagesToCollections: true
permalink: /work/{{ project.slug }}/
eleventyComputed:
  title: "{{ project.title }}"
  description: "{{ project.summary }}"
---
<article class="case-study shell"><a class="text-link" href="/work/">← 01 Work</a><header class="page-intro"><p class="overline">{{ project.kind }} / {{ project.field }}</p><h1>{{ project.title }}</h1><p>{{ project.summary }}</p><div class="tech-list">{% for tech in project.tech %}<span>{{ tech }}</span>{% endfor %}</div></header>{% if project.image %}<figure class="case-image"><img src="/assets/img/projects/{{ project.image }}.webp" width="{{ project.imageWidth }}" height="{{ project.imageHeight }}" alt="{{ project.title }} website screenshot"></figure>{% endif %}<div class="case-body"><aside><p class="project-type">My role</p><h2>{{ project.role }}</h2><p class="project-type" style="margin-top:22px">Organisation</p><p>{{ project.org }}</p>{% if project.url %}<a class="btn" href="{{ project.url }}" target="_blank" rel="noopener noreferrer" style="margin-top:22px">{{ project.linkLabel }} ↗</a>{% endif %}</aside><div><section><p class="project-type">01</p><h2>Problem</h2><p>{{ project.context }}</p></section><section><p class="project-type">02</p><h2>System</h2><p>{{ project.summary }}</p></section><section><p class="project-type">03</p><h2>Architecture</h2><p>{{ project.approach }}</p><p class="fine-print">Stack: {{ project.tech | join(', ') }}</p></section><section><p class="project-type">04</p><h2>Implementation</h2><ul>{% for feature in project.features %}<li>{{ feature }}</li>{% endfor %}</ul>{% if project.challenge %}<p><b>What was difficult:</b> {{ project.challenge }}</p>{% endif %}</section><section><p class="project-type">05</p><h2>Result</h2><p>{{ project.result }}</p></section>{% if project.note %}<p class="case-note">{{ project.note }}</p>{% endif %}</div></div></article>{% if project.slug == "content-pipeline" %}{% include "partials/pipeline-walkthrough.njk" %}{% endif %}{% include "partials/studio-contact.njk" %}
