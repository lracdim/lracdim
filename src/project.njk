---
layout: layouts/base.njk
pagination:
  data: portfolio
  size: 1
  alias: project
  addAllPagesToCollections: true
permalink: /work/{{ project.slug }}/
eleventyComputed:
  title: "{{ project.title }}"
  description: "{{ project.summary }}"
---
<article class="case-study shell"><a class="text-link" href="/work/">← 01 Work</a><header class="page-intro"><p class="overline">{{ project.kind }} / {{ project.field }}</p><h1>{{ project.title }}</h1><p>{{ project.summary }}</p><div class="tech-list">{% for tech in project.tech %}<span>{{ tech }}</span>{% endfor %}</div></header>{% if project.image %}<figure class="case-image"><img src="/assets/img/projects/{{ project.image }}.webp" width="{{ project.imageWidth }}" height="{{ project.imageHeight }}" alt="{{ project.title }} website screenshot"></figure>{% endif %}<div class="case-body"><aside><p class="project-type">My role</p><h2>{{ project.role }}</h2><p class="project-type" style="margin-top:22px">Organisation</p><p>{{ project.org }}</p><p class="project-type" style="margin-top:22px">Category</p><p>{{ project.group }}</p><p class="project-type" style="margin-top:22px">Technology</p><div class="tech-list" style="margin-top:8px">{% for tech in project.tech %}<span>{{ tech }}</span>{% endfor %}</div>{% if project.url %}<a class="btn" href="{{ project.url }}" target="_blank" rel="noopener noreferrer" style="margin-top:22px">{{ project.linkLabel }} ↗</a>{% endif %}</aside><div><section><p class="project-type">01</p><h2>Overview</h2><p>{{ project.summary }}</p></section><section><p class="project-type">02</p><h2>The problem</h2><p>{{ project.context }}</p></section>{% if project.constraints %}<section><p class="project-type">03</p><h2>Constraints</h2><p>{{ project.constraints }}</p></section>{% endif %}<section><p class="project-type">04</p><h2>What I built</h2><ul>{% for feature in project.features %}<li>{{ feature }}</li>{% endfor %}</ul></section><section><p class="project-type">05</p><h2>Architecture</h2><p>{{ project.approach }}</p></section>{% if project.decisions %}<section><p class="project-type">06</p><h2>Key decisions</h2><p>{{ project.decisions }}</p></section>{% endif %}{% if project.challenge %}<section><p class="project-type">07</p><h2>Challenges</h2><p>{{ project.challenge }}</p></section>{% endif %}<section><p class="project-type">08</p><h2>Result</h2><p>{{ project.result }}</p></section>{% if project.lessons %}<section><p class="project-type">09</p><h2>Lessons</h2><p>{{ project.lessons }}</p></section>{% endif %}{% if project.note %}<p class="case-note">{{ project.note }}</p>{% endif %}<section class="related"><p class="project-type">Related</p><h2>Across the dimensions</h2><ul class="related-list">{% for slug in project.related %}{% for other in portfolio %}{% if other.slug == slug %}<li><a href="/work/{{ other.slug }}/"><span class="project-type">01 Work / {{ other.kind }}</span>{{ other.title }} ↗</a></li>{% endif %}{% endfor %}{% endfor %}{% if project.url %}<li><a href="/vector/?url={{ project.url | urlencode }}"><span class="project-type">02 Vector</span>Examine {{ project.title }} with the Web Clinic ↗</a></li>{% endif %}{% if project.slug == 'content-pipeline' or project.slug == 'spade-inbox' or project.slug == 'spade-handler' %}<li><a href="/research/ai-agents-pilots-versus-production/"><span class="project-type">05 Research</span>AI agents: why most pilots stall ↗</a></li>{% endif %}{% if project.slug == 'argus' %}<li><a href="/research/ai-awareness-hallucinations-still-happen/"><span class="project-type">05 Research</span>AI awareness and website assistants ↗</a></li>{% endif %}{% if project.slug == 'spade-website' or project.slug == 'rankking' %}<li><a href="/research/is-this-the-end-of-the-wordpress-era/"><span class="project-type">05 Research</span>Is this the end of the WordPress era? ↗</a></li><li><a href="/forge/metadata-checker/"><span class="project-type">04 Forge</span>Metadata checker ↗</a></li>{% endif %}{% if project.slug == 'lracdimension' %}<li><a href="/research/designing-a-website-health-scoring-engine/"><span class="project-type">05 Research</span>Designing the scoring engine ↗</a></li><li><a href="/research/building-a-safe-website-crawler/"><span class="project-type">05 Research</span>The crawler's safety policy ↗</a></li>{% endif %}</ul></section></div></div></article>{% if project.slug == "content-pipeline" %}{% include "partials/pipeline-walkthrough.njk" %}{% endif %}{% include "partials/studio-contact.njk" %}
