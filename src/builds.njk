---
layout: layouts/base.njk
title: Builds
permalink: /builds/
description: Actual systems and applications in production. Live architecture, stack decisions, and measured outcomes.
---

<section class="pagehead">
  <div class="hero__grid-bg" aria-hidden="true"></div>
  <div class="shell" style="position:relative;z-index:1">
    <span class="label label--signal">Output layer</span>
    <h1 class="h1" style="margin-top:1rem">Builds</h1>
    <p class="lede" style="margin-top:1.5rem">
      Actual systems and applications that exist because of me. Architecture,
      stack decisions, and what each one measurably changed.
    </p>

    <div class="pagehead__meta">
      <span class="label label--faint">{{ builds.length }} systems</span>
      <span class="label label--faint">Production deployments</span>
      <span class="label label--faint">{{ site.location }}</span>
    </div>
  </div>
</section>

<section class="band section">
  <div class="shell">
    <div class="cards">
      {% for build in builds %}
        <article class="card" data-reveal data-reveal-delay="{{ loop.index0 * 80 }}">
          <div class="card__media">
            <span class="card__badge">{{ build.category }}</span>
            <img src="{{ build.img }}" alt="{{ build.title }}" loading="lazy" decoding="async">
          </div>

          <div class="card__body">
            <h2 class="h3">{{ build.title }}</h2>
            <p class="body body--sm" style="margin-top:.75rem">{{ build.desc }}</p>
            <div class="work__tech">
              {% for t in build.tech %}<span class="tag">{{ t }}</span>{% endfor %}
            </div>
          </div>

          <div class="card__foot">
            <span class="label label--faint">{{ loop.index0 | pad }}</span>
            <span class="label label--signal">{{ build.metric }}</span>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="band section section--tight">
  <div class="shell">
    <div class="stats">
      {% for stat in stats %}
        <div class="stat" data-reveal data-reveal-delay="{{ loop.index0 * 80 }}">
          <div class="stat__count">{{ stat.count }}</div>
          <div class="stat__title">{{ stat.title }}</div>
          <div class="stat__desc">{{ stat.desc }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="band band--dark section">
  <div class="shell">
    <h2 class="h2" style="max-width:20ch">
      Want to know what your current system is costing you?
    </h2>
    <div style="margin-top:2rem">
      <button type="button" class="btn btn--ghost" data-open-diagnostic>
        Analyze my website <span class="btn__glyph" aria-hidden="true">&#8599;</span>
      </button>
    </div>
  </div>
</section>
