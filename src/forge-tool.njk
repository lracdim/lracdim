---
layout: layouts/base.njk
pagination:
  data: forgeTools
  size: 1
  alias: tool
  addAllPagesToCollections: true
permalink: /forge/{{ tool.slug }}/
eleventyComputed:
  title: "{{ tool.name }} — Forge"
  description: "{{ tool.summary }}"
---
<section class="shell portfolio-section page-intro dim-head" data-dimension="forge">
  <p class="overline"><a href="/forge/">04 / Forge</a> / {{ tool.category }} / {{ 'Client-side' if tool.mode == 'client' else 'Server-side' }}</p>
  <h1>{{ tool.name }}</h1>
  <p>{{ tool.summary }} {% if tool.mode == 'client' %}Runs entirely in your browser; nothing you enter leaves the page.{% else %}Fetches the target through the engine's validated fetcher: public http and https addresses only, size and time limits, rate-limited.{% endif %}</p>
</section>
<section class="shell portfolio-section" data-forge>
  <article class="forge-tool forge-tool--page" id="{{ tool.slug }}" data-tool="{{ tool.slug }}" data-mode="{{ tool.mode }}">
    {% if tool.mode == 'server' %}{% include "partials/forge/server-tool.njk" %}{% else %}{% include "partials/forge/" ~ tool.slug ~ ".njk" %}{% endif %}
  </article>
  <nav class="forge-index" aria-label="Other tools" style="margin-top:44px">{% for t in forgeTools %}{% if t.slug != tool.slug %}<a href="/forge/{{ t.slug }}/">{{ t.name }}</a>{% endif %}{% endfor %}</nav>
</section>
{% include "partials/studio-contact.njk" %}
