---
layout: layouts/base.njk
title: Research
permalink: /research/
description: "Sourced articles by John Carl Dimatulac on AI, web development, and the responsible use of both."
---
{% set dim = dimensions[4] %}{% set dimLede = "Sourced articles, build logs, and technical investigations. Written to show the reasoning, not only the conclusion, and checked against the numbers." %}{% include "partials/dimension-head.njk" %}
<section class="shell portfolio-section notes-list">
{% set posts = collections.research | sort(false, false, "data.order") %}
{% for post in posts %}
<article data-enter class="{% if post.data.image %}has-thumb{% endif %}">{% if post.data.image %}<a class="note-thumb" href="{{ post.url }}" tabindex="-1" aria-hidden="true"><img src="{{ post.data.image }}" alt="" width="1024" height="572" loading="lazy" decoding="async"></a>{% endif %}<div><p class="project-type">{{ post.data.topic }} / {{ post.date | date_long }} / {{ post.templateContent | reading_time }} min read</p><h2><a href="{{ post.url }}">{{ post.data.title }} ↗</a></h2><p>{{ post.data.description }}</p><a class="text-link" href="{{ post.url }}">Read the article ↗</a></div></article>
{% endfor %}
</section>
{% include "partials/studio-contact.njk" %}
