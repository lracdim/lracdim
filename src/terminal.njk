---
layout: layouts/base.njk
title: Terminal
permalink: /terminal/
description: Interactive console. Query the system directly — type help to list available commands.
---

<section class="pagehead">
  <div class="hero__grid-bg" aria-hidden="true"></div>
  <div class="shell" style="position:relative;z-index:1">
    <span class="label label--signal">Interface layer</span>
    <h1 class="h1" style="margin-top:1rem">Terminal</h1>
    <p class="lede" style="margin-top:1.5rem">
      Query the system directly. Type <code>help</code> to list commands, or
      <code>diagnostic</code> to open the analysis protocol.
    </p>
  </div>
</section>

<section class="band section">
  <div class="shell">
    {% include "partials/terminal.njk" %}

    <div class="cells" style="margin-top:3rem">
      {% for cmd in [
        { name: "about", desc: "Who is behind this system" },
        { name: "skills", desc: "Technical capability list" },
        { name: "projects", desc: "Recent builds" },
        { name: "ops", desc: "Operational history" },
        { name: "diagnostic", desc: "Open the website diagnostic protocol" },
        { name: "contact", desc: "Contact information" }
      ] %}
        <div class="cell">
          <span class="cell__num">{{ loop.index0 | pad }}</span>
          <div class="cell__title" style="font-family:var(--font-mono);font-size:1rem">{{ cmd.name }}</div>
          <p class="cell__desc">{{ cmd.desc }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
