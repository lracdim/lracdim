---
demoTitle: Book a visit
demoDescription: Send a booking request to the front desk. Someone calls you back the same business day to fix the time.
---
{% set base = '/demos/' + demoMeta.slug + '/' %}
{% include "demos/clinic/top.njk" %}

<main>
  <section class="band--md">
    <div class="wrap wrap--narrow">

      <h1 class="h1">Book a visit</h1>
      <p class="lede" style="margin-top:1rem">{{ demo.bookingNote }}</p>

      <p class="callout" style="margin-top:1.5rem" data-preselect hidden></p>

      {# ------------------------------------------------------- form --- #}
      <div data-book-panel style="margin-top:2.5rem">
        <form class="form" data-book-form novalidate>

          <div class="row2">
            <div class="field">
              <label for="bk-name">Your full name</label>
              <input id="bk-name" name="name" type="text" autocomplete="name" required>
              <span class="field__error" data-error></span>
            </div>

            <div class="field">
              <label for="bk-dob">Date of birth</label>
              <input id="bk-dob" name="dob" type="date" required>
              <span class="field__error" data-error></span>
            </div>
          </div>

          <div class="row2">
            <div class="field">
              <label for="bk-phone">Phone</label>
              <span class="field__hint">This is the number we call back on.</span>
              <input id="bk-phone" name="phone" type="tel" autocomplete="tel" required>
              <span class="field__error" data-error></span>
            </div>

            <div class="field">
              <label for="bk-insurer">Insurance</label>
              <select id="bk-insurer" name="insurer">
                <option value="">Choose your plan</option>
                {% for i in demo.insurers %}<option value="{{ i }}">{{ i }}</option>{% endfor %}
                <option value="Self-pay">Paying myself</option>
                <option value="Not sure">Not sure</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="bk-reason">What is the visit for</label>
            <select id="bk-reason" name="reason" required>
              <option value="">Choose one</option>
              {% for r in demo.visitReasons %}<option value="{{ r }}">{{ r }}</option>{% endfor %}
            </select>
            <span class="field__error" data-error></span>
          </div>

          <div class="row2">
            <div class="field">
              <label for="bk-provider">Provider</label>
              <select id="bk-provider" name="provider">
                {% for p in demo.providers %}
                  <option value="{{ p.id }}">
                    {% if p.credential == 'FNP-C' %}{{ p.name }}, {{ p.credential }}{% else %}Dr. {{ p.name }}{% endif %} — {{ p.role }}
                  </option>
                {% endfor %}
              </select>
            </div>

            <div class="field">
              <label for="bk-date">Preferred date</label>
              <input id="bk-date" name="date" type="date" required>
              <span class="field__error" data-error></span>
            </div>
          </div>

          <div class="field">
            <label for="bk-time">Preferred time</label>
            <span class="field__hint">Leave this if any time works.</span>
            <input id="bk-time" name="time" type="time" step="600">
          </div>

          <div class="field">
            <label for="bk-notes">Anything we should know</label>
            <span class="field__hint">Symptoms, how long it has been going on, or a question you want answered.</span>
            <textarea id="bk-notes" name="notes"></textarea>
          </div>

          <button type="submit" class="btn btn--block">
            Send this request to the front desk
          </button>

          <p class="note">
            Sending this does not confirm a time. If this is an emergency, call 911.
          </p>
        </form>
      </div>

      {# --------------------------------------------------- confirmed --- #}
      <div class="confirm" data-book-done hidden style="margin-top:2.5rem">
        <h2 class="h2">Request sent</h2>

        <p class="prose" style="margin-top:1rem">
          It is now sitting on the front desk screen. Someone will call
          <b data-done-phone></b> the same business day, usually within two
          hours, to confirm.
        </p>

        <p class="prose" style="margin-top:1rem">
          You asked for <b data-done-summary></b>
        </p>

        <div class="callout" style="margin-top:1.5rem">
          This is a demonstration. Your request was written to this browser
          only. Open the staff portal to watch it arrive on today's schedule,
          check the patient in, and see the invoice it raises.
        </div>

        <div style="margin-top:1.5rem;display:flex;flex-wrap:wrap;gap:.75rem">
          <a class="btn" href="{{ base }}portal/" data-done-portal>Open the staff portal</a>
          <a class="btn btn--quiet" href="{{ base }}">Back to the home page</a>
        </div>
      </div>

    </div>
  </section>
</main>

{% include "demos/clinic/foot.njk" %}
