---
layout: layouts/base.njk
ogType: article
---
{%- from "partials/rd-pagehead.njk" import pagehead -%}
{{ pagehead({
  back: { label: 'All research', href: '/research/' },
  badge: topic ~ (' · ' ~ category if category else '') ~ ' · ' ~ (page.date | date_long) ~ ' · ' ~ (content | reading_time) ~ ' min read',
  title: title,
  sub: description,
  chips: technologies or [],
  compact: true
}) }}
<article class="case-study shell post">
  {% if image %}<figure class="case-image post-hero"><img src="{{ image }}" alt="{{ imageAlt or title }}" width="1024" height="572" decoding="async" fetchpriority="high"></figure>{% endif %}
  <div class="prose">
    {{ content | safe }}
  </div>
  {% if project %}
    {% for p in portfolio %}{% if p.slug == project %}
      <p class="case-note">Related project: <a href="/work/{{ p.slug }}/">{{ p.title }}</a> — {{ p.kind }}.</p>
    {% endif %}{% endfor %}
  {% endif %}
</article>
{% include "partials/studio-contact.njk" %}
