<div class="forge-field"><label for="slug-in">Title</label><input id="slug-in" type="text" placeholder="Is this the end of the WordPress era?"></div>
<div class="forge-actions"><label class="forge-check"><input type="checkbox" data-opt="stopwords"> Drop common words (a, the, of, is)</label><button type="button" class="btn btn--ghost" data-action="copy">Copy slug</button></div>
<div class="forge-field"><label for="slug-out">Slug</label><output id="slug-out" for="slug-in" data-output></output></div>
<p class="forge-status" data-status role="status"></p>
