<div class="forge-grid">
  <div class="forge-field"><label for="time-in">Unix timestamp or ISO date</label><input id="time-in" type="text" spellcheck="false" placeholder="1788974391 or 2026-09-10T00:00:00Z"></div>
  <div class="forge-actions forge-actions--inline"><button type="button" class="btn" data-action="convert">Convert ↗</button><button type="button" class="btn btn--ghost" data-action="now">Now</button></div>
</div>
<div class="forge-output" data-output aria-live="polite"></div>
<p class="forge-status" data-status role="status"></p>
