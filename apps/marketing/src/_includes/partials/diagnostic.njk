{# "Diagnose my site": hands the address to Vector (assets/js/modal.js). #}
<div class="modal" id="diagnostic" role="dialog" aria-modal="true"
     aria-labelledby="diagnostic-protocol" hidden>

  <button type="button" class="modal__backdrop" data-close-diagnostic aria-label="Close diagnostic"></button>

  <div class="modal__panel">
    <div class="modal__head">
      <div class="modal__protocol" id="diagnostic-protocol">
        <span class="modal__led" aria-hidden="true"></span>
        Vector / Web Clinic
      </div>
      <button type="button" class="modal__close" data-close-diagnostic aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="modal__body">
      <div class="modal__step" data-step="input">
        <h2 class="h3" style="margin-bottom:.5rem">Examine a website</h2>
        <p class="body body--sm" style="margin-bottom:1.75rem">
          Vector reads the live site in about twenty seconds: eight categories, every issue with its evidence. You see the summary straight away, and the full report with the fixes in priority order is emailed to you.
        </p>

        <form id="diagnostic-form" novalidate>
          <div class="field">
            <label class="field__label" for="diag-url">Company website URL</label>
            <input class="field__input" id="diag-url" name="url" type="text"
                   inputmode="url" autocomplete="url" required placeholder="company.com">
          </div>

          <div class="field">
            <label class="field__label" for="diag-pain">Biggest problem with the site <span class="fine-print">(optional)</span></label>
            <input class="field__input" id="diag-pain" name="pain" type="text" maxlength="1000"
                   placeholder="Slow pages, no leads, hard to update…">
          </div>

          <div class="field">
            <label class="field__label" for="diag-email">Where should the full report go? <span class="fine-print">(optional, you can add it after)</span></label>
            <input class="field__input" id="diag-email" name="email" type="email"
                   autocomplete="email" placeholder="you@company.com">
          </div>

          <p class="intake__error" data-diag-error role="alert"></p>
          <button type="submit" class="btn btn--block" style="margin-top:1.25rem">
            Examine my site <span class="btn__glyph" aria-hidden="true">&#8599;</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
