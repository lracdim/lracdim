{%- from "partials/rd-icons.njk" import icon -%}
{#- Pill navigation (redesign). The menu words are the live site's: the five
    dimensions plus About. Services, Process, industries and the demo stay in
    the footer. Behaviour: assets/js/redesign.js compacts it on scroll;
    assets/js/studio.js drives the mobile drawer via data-nav-toggle. -#}
{%- set primary = [] -%}
{%- for d in dimensions %}{% set primary = (primary.push({ label: d.name, href: d.href }), primary) %}{% endfor -%}
{%- set primary = (primary.push({ label: 'About', href: '/about/' }), primary) -%}
<header class="rd-hdr" data-header data-rd-header>
  <div class="rd-hdr__in">
    <a class="rd-brand" href="/" aria-label="{{ site.name }} home">
      <img class="rd-brand__mark" src="/assets/img/brand/mark.png" width="72" height="72" alt="">
      <span class="rd-brand__name">{% include "partials/logotype.njk" %}</span>
    </a>

    <nav class="rd-nav" aria-label="Primary">
      <ul class="rd-nav__list">
        {%- for item in primary %}
        <li><a class="rd-nav__link" href="{{ item.href }}" {% if page.url.startsWith(item.href) %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>

    <div class="rd-hdr__end">
      <a class="rd-btn rd-btn--white rd-hdr__cta" href="{{ site.cta.href }}" data-open-start>
        {{ site.cta.label }}<span class="rd-btn__chip">{{ icon('arrow-up-right') }}</span>
      </a>
      <button type="button" class="rd-menu" data-nav-toggle aria-expanded="false" aria-controls="drawer">
        <span class="rd-sr" data-nav-toggle-label>Menu</span>
        <span class="rd-menu__bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div class="drawer rd-drawer" id="drawer" data-drawer>
  <nav aria-label="Primary">
    {%- for item in primary %}
    <a class="rd-drawer__link" href="{{ item.href }}">{{ item.label }} {{ icon('arrow-up-right') }}</a>
    {%- endfor %}
  </nav>
  <div class="rd-drawer__foot">
    <a class="rd-btn rd-btn--white" href="{{ site.cta.href }}" data-open-start>{{ site.cta.label }}<span class="rd-btn__chip">{{ icon('arrow-up-right') }}</span></a>
  </div>
</div>
