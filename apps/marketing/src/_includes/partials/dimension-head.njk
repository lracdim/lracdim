{#
  Standard head for a dimension page. Expects `dim` (an entry from
  _data/dimensions.js) and optional `dimLede` text set by the page.
  Renders the shared landing-style head (partials/rd-pagehead.njk).
#}
{%- from "partials/rd-pagehead.njk" import pagehead -%}
<div data-dimension="{{ dim.slug }}">
{%- call pagehead({
  badge: dim.index ~ ' · ' ~ dim.name ~ ' · ' ~ dim.identity,
  titleHtml: dim.name ~ ' <span class="signal">' ~ dim.descriptor ~ '.</span>',
  sub: dimLede,
  chips: dim.verbs
}) -%}
  {%- if dim.status == 'building' %}<p class="dim-status dim-status--building"><span></span>In build. No data is shown until it is measured.</p>{% endif -%}
{%- endcall %}
</div>
