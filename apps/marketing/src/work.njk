{% set dim = dimensions[0] %}{% set dimLede = "Client work, internal tools, working demos, and independent concepts. Each case study states the problem, what was built, why it was designed that way, and what shipped. Labels keep the distinctions honest." %}{% include "partials/dimension-head.njk" %}<section class="shell portfolio-section work-collection"><div class="project-showcase">{% for project in portfolio %}{% if project.featured %}<article class="project-feature" data-enter><a class="project-image" href="/work/{{ project.slug }}/" aria-label="Explore {{ project.title }}"><img src="/assets/img/projects/{{ project.image }}.webp" width="{{ project.imageWidth }}" height="{{ project.imageHeight }}" alt="{{ project.title }} homepage" loading="lazy"></a><div class="project-caption"><div><p class="project-type">{{ project.kind }}</p><h2><a href="/work/{{ project.slug }}/">{{ project.title }} ↗</a></h2></div><p>{{ project.summary }}</p></div></article>{% endif %}{% endfor %}</div>{% for group in ['Websites','Applications','Business Systems','Automation','Experiments'] %}{% set any = false %}{% for project in portfolio %}{% if project.group == group and not project.featured %}{% set any = true %}{% endif %}{% endfor %}{% if any %}<h2 class="collection-heading">{{ group }}</h2><div class="project-index">{% for project in portfolio %}{% if project.group == group and not project.featured %}<a href="/work/{{ project.slug }}/"><span class="project-type">{{ project.kind }}</span><h3>{{ project.title }}</h3><p>{{ project.summary }}</p><span aria-hidden="true">↗</span></a>{% endif %}{% endfor %}</div>{% endif %}{% endfor %}</section>{% include "partials/studio-contact.njk" %}
