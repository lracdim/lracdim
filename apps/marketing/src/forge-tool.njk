---
layout: layouts/base.njk
pagination:
  data: forgeTools
  size: 1
  alias: tool
  addAllPagesToCollections: true
permalink: /forge/{{ tool.slug }}/
eleventyComputed:
  title: "{{ tool.seo.title if tool.seo else tool.name ~ ' — Forge' }}"
  description: "{{ tool.seo.description if tool.seo else tool.summary }}"
---
{%- from "partials/rd-pagehead.njk" import pagehead -%}
<div data-dimension="forge">
{{ pagehead({
  back: { label: 'All Forge tools', href: '/forge/' },
  badge: '04 · Forge · ' ~ tool.category ~ ' · ' ~ ('Runs in your browser' if tool.mode == 'client' else 'Runs on the engine'),
  title: tool.name,
  sub: tool.summary ~ (' Runs entirely in your browser; nothing you enter leaves the page.' if tool.mode == 'client' else " Fetches the target through the engine's validated fetcher: public http and https addresses only, size and time limits, rate-limited.")
}) }}
</div>
<section class="shell portfolio-section" data-forge>
  <article class="forge-tool forge-tool--page" id="{{ tool.slug }}" data-tool="{{ tool.slug }}" data-mode="{{ tool.mode }}">
    {% if tool.mode == 'server' %}{% include "partials/forge/server-tool.njk" %}{% else %}{% include "partials/forge/" ~ tool.slug ~ ".njk" %}{% endif %}
  </article>
  {% set seo = tool.seo %}
  {% if seo %}{% include "partials/tool-guide.njk" %}{% endif %}
  <nav class="forge-index" aria-label="Other tools" style="margin-top:44px">{% for t in forgeTools %}{% if t.slug != tool.slug %}<a href="/forge/{{ t.slug }}/">{{ t.name }}</a>{% endif %}{% endfor %}</nav>
</section>
{% include "partials/studio-contact.njk" %}
