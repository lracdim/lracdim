{
  "name": "lracdim-api-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LRACDIMENSION API on Cloudflare Workers: project intake in D1, other routes forwarded to the Python API.",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply lracdim-api --local",
    "db:migrate:remote": "wrangler d1 migrations apply lracdim-api --remote"
  },
  "devDependencies": {
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "htmlparser2": "9.1.0"
  }
}
