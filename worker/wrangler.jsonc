{
  // LRACDIMENSION API on Cloudflare Workers. Runs on the free plan.
  // Secrets are set with `npx wrangler secret put <NAME>`, never written here:
  //   RESEND_API_KEY, NOTIFY_EMAIL, ADMIN_KEY, RATE_LIMIT_SALT,
  //   TURNSTILE_SECRET, RESEND_WEBHOOK_SECRET, REPORT_SIGNING_KEY (optional)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lracdim-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lracdim-api",
      "database_id": "48b73f14-c8ae-45a8-abc7-d8954d1db478",
      "migrations_dir": "migrations"
    }
  ],
  // Emails the full Vector report: summary, send with retries, owner alert
  // (src/workflow.js, src/report-delivery.js). Renaming `name` creates a new
  // Workflow instead of updating this one.
  "workflows": [
    {
      "name": "report-delivery",
      "binding": "REPORT_WORKFLOW",
      "class_name": "ReportDeliveryWorkflow"
    }
  ],
  // Workers AI writes the plain-English summary in the report email.
  "ai": { "binding": "AI" },
  // Browser Run prints the full report to the PDF attached to that email
  // (src/report-pdf.js). Free plan: 10 browser minutes a day.
  "browser": { "binding": "BROWSER" },
  // Signal's scheduled checks (the Python API ran them on a background thread),
  // and the report-delivery backstop and retention sweep.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // Origins allowed to call the API. lracdimension.vercel.app and the bare
    // domain redirect to www, so www is the one visitors actually use.
    "CORS_ORIGINS": "https://www.lracdimension.online,https://lracdimension.online,https://lracdimension.vercel.app,http://localhost:8099",
    // Senders. lracdimension.online is verified in Resend (region
    // ap-northeast-1); its DKIM, send/rsend CNAMEs and DMARC records live in
    // Z.com DNS. Replies reach Resend once the domain's MX points at it
    // (Resend Inbound), and src/inbound.js forwards them to NOTIFY_EMAIL
    // (or INBOUND_FORWARD_TO, a secret, if set). Every address below is
    // public: NOTIFY_EMAIL (a secret, the owner's private inbox) is never used
    // as a sender or Reply-To.
    // Owner alerts and the project-inquiry acknowledgement:
    "RESEND_FROM": "LRACDIMENSION <hello@lracdimension.online>",
    "INTAKE_REPLY_TO": "hello@lracdimension.online",
    // Acknowledge each project inquiry from the domain, through Resend.
    "RESEND_AUTOREPLY": "true",
    // The emailed Vector report comes from John, and replies reach him:
    "REPORT_FROM": "John Carl Dimatulac <john@lracdimension.online>",
    "REPORT_REPLY_TO": "john@lracdimension.online",
    // Per-visitor limits, same as the Python API.
    "RATE_LIMIT_CONTACT": "5/hour",
    "RATE_LIMIT_AUDITS": "6/hour",
    "RATE_LIMIT_TOOLS": "60/hour",
    "RATE_LIMIT_SIGNAL": "10/hour",
    // A check slower than this marks the site degraded.
    "SIGNAL_RESPONSE_WARN_MS": "1500",

    // ---- Emailed full reports -------------------------------------------
    // Links in the email point at the site; the one-click unsubscribe header
    // points at this Worker.
    "SITE_URL": "https://www.lracdimension.online",
    "API_URL": "https://lracdim-api.lracdim.workers.dev",
    // Report requests per visitor IP.
    "RATE_LIMIT_REPORTS": "5/hour",
    // One report per address, and one per website (any page of it, with or
    // without www), every this many days. "0" turns a limit off.
    "REPORT_EMAIL_COOLDOWN_DAYS": "7",
    "REPORT_SITE_COOLDOWN_DAYS": "7",
    // Reports per UTC day, all visitors. Each report is two emails (the report
    // and the owner alert); Resend's free plan allows 100 a day in total.
    "REPORT_DAILY_CAP": "40",
    // How long the link to the online full report works.
    "REPORT_LINK_DAYS": "30",
    // After this, a request's name, address, company and note are erased.
    "REPORT_RETENTION_DAYS": "365",
    // Summary model; "off" uses the rule-based summary only.
    "REPORT_AI": "on",
    "REPORT_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    // Attach the report as a PDF; "off" sends the email without it.
    "REPORT_PDF": "on",
    // Set to "true" once TURNSTILE_SECRET is set: requests are then refused
    // whenever the check cannot run, instead of skipping it.
    "TURNSTILE_REQUIRED": "false"
  }
}
